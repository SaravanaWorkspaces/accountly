# Postgres connection string. On Vercel, the Postgres integration sets
# POSTGRES_URL for you and either name works. Use a POOLED endpoint in
# production (Neon's "-pooler" host) — a serverless app opens a lot of them.
DATABASE_URL=postgres://postgres@127.0.0.1:5432/accountly
# 32+ char secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace-me-with-a-long-random-secret-at-least-32-chars
# Vercel Blob read-write token. Set it and receipts are stored in Vercel Blob
# (required on Vercel: its filesystem is ephemeral). Leave it unset and they
# are written to UPLOAD_DIR on local disk.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
